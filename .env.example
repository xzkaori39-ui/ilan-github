# i兰 / iLAN：复制为 .env 后填写。不要提交 .env。

# 对话模型：可使用任意 OpenAI 兼容中转站。
DEEPSEEK_API_KEY=replace-with-chat-api-key
DEEPSEEK_BASE_URL=https://your-chat-gateway.example/v1
DEEPSEEK_MODEL=gpt-5.4
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

# Embedding / 可选远程重排：可与对话模型使用不同的中转站。
RELAY_API_KEY=replace-with-embedding-api-key
RELAY_BASE_URL=https://your-embedding-gateway.example/v1
RELAY_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=relay
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# 开源本地重排模型（首次启动会下载模型）。
RERANKER_ENABLED=true
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Docker 内部存储连接；Compose 会覆盖主机地址。
STORAGE_MODE=mongo
MONGO_INITDB_ROOT_USERNAME=ilan_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-mongo-password
MONGODB_URI=mongodb://ilan_admin:replace-with-strong-mongo-password@localhost:27017/ilan?authSource=admin
MONGODB_DB=ilan
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_ADDR=redis://:replace-with-strong-redis-password@localhost:6379
REDIS_DB=0
VECTOR_BACKEND=mongo
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=ilan_chunks
MILVUS_DIMENSION=1024         # 必须与 EMBEDDING_DIM 一致
MILVUS_TOKEN=

# GraphRAG / Neo4j。首次演示可保持 false；完成图谱构建后再设为 true。
GRAPH_ENABLED=false
NEO4J_PASSWORD=replace-with-strong-neo4j-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
GRAPH_EXPANSION_LIMIT=2

# 服务与安全。部署公网时请使用强随机值并收紧 CORS。
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080
AUTH_SECRET=replace-with-a-long-random-auth-secret
INTERNAL_API_TOKEN=replace-with-a-long-random-internal-token
AUTH_TOKEN_TTL_HOURS=24
SEED_DEMO_USERS=true
PI_AGENT_ENABLED=true
PI_AGENT_URL=http://pi-agent:8100
MAX_UPLOAD_MB=20
